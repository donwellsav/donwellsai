+/// Replay dimensions and bytes share the parser lock; the visible surface keeps its pixel geometry.
+pub fn processReplayGrid(self: *Termio, buf: []const u8, cols: u16, rows: u16) void {
+    if (cols < 2 or rows < 2) return;
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    self.terminal.resize(self.alloc, .{ .cols = cols, .rows = rows, .cell_size_px = .{ .width = self.size.cell.width, .height = self.size.cell.height } }) catch return;
+    const previous = self.terminal_stream.handler.suppress_terminal_responses;
+    self.terminal_stream.handler.suppress_terminal_responses = true;
+    defer self.terminal_stream.handler.suppress_terminal_responses = previous;
+    self.processOutputLocked(buf);
+}
