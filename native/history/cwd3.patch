+func TestKimiProviderUsesCurrentStateCwdWhenWireHasNoConfigUpdate(t *testing.T) {
+	root := t.TempDir()
+	session := filepath.Join(root, "wd_lossy_hash", "session_native")
+	sourcePath := filepath.Join(session, "agents", "main", "wire.jsonl")
+	writeSourceFile(t, sourcePath, kimiProviderFixture("state cwd"))
+	require.NoError(t, os.WriteFile(filepath.Join(session, "state.json"), []byte(`{"version":2,"id":"session_native","cwd":"/Users/helix/Code/terminal-foundation"}`), 0o600))
+	provider, ok := NewProvider(AgentKimi, ProviderConfig{Roots: []string{root}})
+	require.True(t, ok)
+	sources, err := provider.Discover(context.Background())
+	require.NoError(t, err)
+	outcome, err := provider.Parse(context.Background(), ParseRequest{Source: sources[0]})
+	require.NoError(t, err)
+	require.Len(t, outcome.Results, 1)
+	assert.Equal(t, "/Users/helix/Code/terminal-foundation", outcome.Results[0].Result.Session.Cwd)
+	assert.Equal(t, "terminal_foundation", outcome.Results[0].Result.Session.Project)
+	assert.Equal(t, "session_native", outcome.Results[0].Result.Session.SourceSessionID)
+	assert.Equal(t, "kimi-wire+state-v2", outcome.Results[0].Result.Session.SourceVersion)
+}
