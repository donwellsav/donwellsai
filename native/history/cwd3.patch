+type kimiStateMetadata struct {
+	Cwd     string `json:"cwd"`
+	WorkDir string `json:"workDir"`
+	ID      string `json:"id"`
+	Version int    `json:"version"`
+}
+
+func kimiStateMetadataForWire(wirePath string) *kimiStateMetadata {
+	statePath := filepath.Join(filepath.Dir(wirePath), "state.json")
+	if filepath.Base(filepath.Dir(filepath.Dir(wirePath))) == "agents" {
+		statePath = filepath.Join(filepath.Dir(wirePath), "..", "..", "state.json")
+	}
+	info, err := os.Stat(statePath)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 1024*1024 {
+		return nil
+	}
+	data, err := os.ReadFile(statePath)
+	if err != nil {
+		return nil
+	}
+	var state kimiStateMetadata
+	if json.Unmarshal(data, &state) != nil {
+		return nil
+	}
+	if state.Cwd == "" {
+		state.Cwd = state.WorkDir
+	}
+	if state.ID == "" || state.ID != filepath.Base(filepath.Dir(statePath)) || state.Version < 1 {
+		return nil
+	}
+	return &state
+}
