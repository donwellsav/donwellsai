{
  "name": "donwells.ai",
  "version": "0.5.1",
  "description": "donwells.ai desktop workspace for parallel agent development",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "license": "UNLICENSED",
  "bin": {
    "donwells": "./cli/donwells.mjs"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && pnpm run build:cli",
    "build:cli": "tsc -p tsconfig.cli.json",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.cli.json",
    "test": "vitest run",
    "icons:build": "node scripts/build-icons.mjs",
    "package:check": "node scripts/check-package.mjs",
    "package:prepare": "pnpm run build && pnpm run build:native-terminal && pnpm run build:native-history && pnpm run notices:build && pnpm run package:check",
    "package:dir": "pnpm run package:prepare && electron-builder --config build/electron-builder.json --dir --publish never",
    "package:mac": "pnpm run package:prepare && electron-builder --config build/electron-builder.json --mac dmg --publish never",
    "package:linux": "pnpm run package:prepare && electron-builder --config build/electron-builder.json --linux AppImage tar.gz --publish never",
    "package:win": "pnpm run package:prepare && electron-builder --config build/electron-builder.json --win nsis zip --publish never",
    "profile:recover": "node scripts/profile-recovery.mjs",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-builder install-app-deps",
    "notices:build": "node scripts/build-notices.mjs",
    "build:native-terminal": "node scripts/build-native-terminal.mjs",
    "build:native-history": "node scripts/build-native-history.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pierre/diffs": "^1.3.6",
    "@sentry/electron": "^6.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "flexlayout-react": "0.10.8",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "katex": "^0.18.5",
    "lucide-react": "1.43.0",
    "marked": "^18.0.11",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.12",
    "mermaid": "^11.17.2",
    "monaco-editor": "0.56.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "6.3.289",
    "pino": "^9.14.0",
    "react": "^19.2.8",
    "react-aria": "^3.52.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.5",
    "react-i18next": "^14.1.3",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.18",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "storybook": "^8.6.18",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
