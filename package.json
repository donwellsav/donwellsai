{
  "name": "donwells.ai",
  "version": "0.1.0",
  "description": "donwells.ai: run CLI agents in parallel git worktrees",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "pnpm run build && node tests/smoke.mjs",
    "postinstall": "electron-rebuild -f -w node-pty || true"
  },
  "dependencies": {
    "@electron/rebuild": "^4.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "electron": "^44.1.1",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.11",
    "monaco-editor": "0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "overrides": {
      "rolldown": "1.2.6",
      "@rolldown/binding-android-arm-eabi": "1.2.6",
      "@rolldown/binding-android-arm64": "1.2.6",
      "@rolldown/binding-darwin-arm64": "1.2.6",
      "@rolldown/binding-darwin-x64": "1.2.6",
      "@rolldown/binding-freebsd-x64": "1.2.6",
      "@rolldown/binding-linux-arm-gnueabihf": "1.2.6",
      "@rolldown/binding-linux-arm64-gnu": "1.2.6",
      "@rolldown/binding-linux-arm64-musl": "1.2.6",
      "@rolldown/binding-linux-armv7-gnu": "1.2.6",
      "@rolldown/binding-linux-ia32-gnu": "1.2.6",
      "@rolldown/binding-linux-ia32-musl": "1.2.6",
      "@rolldown/binding-linux-riscv64-gnu": "1.2.6",
      "@rolldown/binding-linux-s390x-gnu": "1.2.6",
      "@rolldown/binding-linux-x64-gnu": "1.2.6",
      "@rolldown/binding-linux-x64-musl": "1.2.6",
      "@rolldown/binding-wasm32-wasi": "1.2.6",
      "@rolldown/binding-win32-arm64-msvc": "1.2.6",
      "@rolldown/binding-win32-ia32-msvc": "1.2.6",
      "@rolldown/binding-win32-x64-msvc": "1.2.6"
    }
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
