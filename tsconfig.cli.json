{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "paths": { "@shared/*": ["./src/shared/*"] },
    "rootDir": "src",
    "outDir": "dist-cli"
  },
  "include": [
    "src/cli/**/*.ts"
  ],
  "exclude": ["src/cli/**/*.test.ts"]
}